# Optional: required only for importing TBS NewsDig videos.
ECHOLOOP_TBS_STREAKS_API_KEY=replace_with_your_key

# Optional: required only for NVIDIA cloud transcription.
NVIDIA_API_KEY=replace_with_your_key

# Optional: required when building the Android learner app with online accounts.
VITE_LEARNER_API_BASE=https://your-domain.example/api

# Optional: DeepL translation used only by the local production backend.
DEEPL_API_KEY=replace_with_your_deepl_api_key
# Usually auto-detected from the key. Override only when your DeepL account requires it.
# DEEPL_API_BASE=https://api-free.deepl.com
