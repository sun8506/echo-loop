limit_req_zone $binary_remote_addr zone=echoloop_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=echoloop_api:10m rate=120r/m;

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    location = /api/auth/register {
        limit_req zone=echoloop_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8010;
        include proxy_params;
    }

    location = /api/auth/login {
        limit_req zone=echoloop_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8010;
        include proxy_params;
    }

    location /api/ {
        limit_req zone=echoloop_api burst=30 nodelay;
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:8010;
        include proxy_params;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
